{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilience-routes.local/schemas/manifest.schema.json",
  "title": "Resilience Routes content pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "status", "description"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "playable"] },
    "description": { "type": "string", "minLength": 20 },
    "contributors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "license": { "type": "string", "minLength": 1 }
  }
}
