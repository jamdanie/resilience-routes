    "create:scenario": "node scripts/scaffold-content.mjs scenario",
    "create:level": "node scripts/scaffold-content.mjs level",
    "test:missions": "node scripts/test-mission-randomization.mjs",
    "test:resources": "node scripts/test-resource-economy.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
