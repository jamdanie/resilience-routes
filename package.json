{
  "name": "resilience-routes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && npm run test:missions && npm run test:resources && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-scenarios.mjs",
